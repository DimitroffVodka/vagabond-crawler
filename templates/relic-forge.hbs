<div class="relic-forge-container">

  {{!-- Header: Preview Name + Cost --}}
  <div class="forge-header">
    <div class="preview-name">
      <i class="fas fa-gem"></i>
      <span class="name-text">{{previewName}}</span>
    </div>
    <div class="preview-cost">
      <i class="fas fa-coins"></i>
      <span class="cost-text">{{totalCostDisplay}}</span>
    </div>
  </div>

  <div class="forge-body">

    {{!-- LEFT: Power Browser --}}
    <div class="forge-column power-browser">
      <h3><i class="fas fa-book-open"></i> Power Database</h3>

      {{!-- Category Filter Tabs --}}
      <div class="category-tabs">
        {{#each categories}}
        <button type="button" class="category-tab {{#if active}}active{{/if}}"
                data-category="{{key}}">
          <i class="{{icon}}"></i> {{label}}
        </button>
        {{/each}}
      </div>

      {{!-- Search box (filters by name + description, composes with category) --}}
      <input type="text" class="power-browser-search"
             placeholder="🔎 Search powers…"
             value="{{powerSearchQuery}}" />

      {{!-- Scrollable Power List --}}
      <div class="power-browser-list">
        {{#each powers}}
        <div class="power-card {{#if selected}}selected{{/if}}"
             data-power-id="{{id}}">
          <div class="power-icon">
            <i class="{{icon}}"></i>
          </div>
          <div class="power-info">
            <div class="power-name">{{name}} <span class="power-cost-tag">{{costDisplay}}</span></div>
            <div class="power-desc">{{description}}</div>
          </div>
          <div class="power-check">
            {{#if selected}}<i class="fas fa-check-circle"></i>{{/if}}
          </div>
          {{#if isUserCustom}}
          <button type="button" class="power-delete-btn" data-power-id="{{id}}"
                  title="Delete this saved custom power">
            <i class="fas fa-trash"></i>
          </button>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </div>

    {{!-- CENTER: Base Item + Config --}}
    <div class="forge-column forge-config">

      <div class="forge-config-grid">
      <div class="forge-config-base">

      {{!-- Drop Zone --}}
      <h3><i class="fas fa-hammer"></i> Base Item</h3>
      <div class="drop-zone {{#if baseItem}}has-item{{/if}}">
        {{#if baseItem}}
          <div class="dropped-item">
            <img src="{{baseItem.img}}" alt="{{baseItem.name}}" width="48" height="48" />
            <div class="item-details">
              <div class="item-name">{{baseItem.name}}</div>
              <div class="item-meta">
                <span class="item-type">{{baseItem.type}}</span>
                <span class="item-metal">{{baseItem.metal}}</span>
                <span class="item-cost">{{baseCostDisplay}}</span>
              </div>
            </div>
            <button type="button" class="clear-btn" title="Remove" aria-label="Remove base item">
              <i class="fas fa-times" aria-hidden="true"></i>
            </button>
          </div>
        {{else}}
          <div class="drop-prompt">
            <i class="fas fa-hand-pointer"></i>
            <p>Drag &amp; drop an equipment item here, or pick from the list below.</p>
          </div>
        {{/if}}
      </div>

      {{!-- Compendium browser — quick alternative to drag-drop. Search filters
           against the weapon + equipment packs; click a row to load it as
           the base item. --}}
      {{#unless baseItem}}
      <div class="forge-browser">
        <input type="text" class="forge-browser-search" placeholder="🔎 Search weapons &amp; equipment…" value="{{browserQuery}}" />
        <div class="forge-browser-filters" role="tablist" aria-label="Filter by kind">
          <button type="button" role="tab" class="forge-browser-filter {{#if (eq browserKindFilter 'all')}}active{{/if}}" data-kind="all" aria-selected="{{#if (eq browserKindFilter 'all')}}true{{else}}false{{/if}}">All</button>
          <button type="button" role="tab" class="forge-browser-filter {{#if (eq browserKindFilter 'weapon')}}active{{/if}}" data-kind="weapon" aria-selected="{{#if (eq browserKindFilter 'weapon')}}true{{else}}false{{/if}}">Weapon</button>
          <button type="button" role="tab" class="forge-browser-filter {{#if (eq browserKindFilter 'armor')}}active{{/if}}" data-kind="armor" aria-selected="{{#if (eq browserKindFilter 'armor')}}true{{else}}false{{/if}}">Armor</button>
          <button type="button" role="tab" class="forge-browser-filter {{#if (eq browserKindFilter 'gear')}}active{{/if}}" data-kind="gear" aria-selected="{{#if (eq browserKindFilter 'gear')}}true{{else}}false{{/if}}">Gear</button>
        </div>
        <div class="forge-browser-list">
          {{#each browserResults}}
          <div class="forge-browser-row" data-uuid="{{uuid}}" title="Click to use as base">
            <img src="{{img}}" alt="" width="24" height="24" />
            <span class="forge-browser-name">{{name}}</span>
            <span class="forge-browser-meta">{{kind}}</span>
          </div>
          {{else}}
          <div class="forge-browser-empty">{{browserEmptyMessage}}</div>
          {{/each}}
        </div>
      </div>
      {{/unless}}

      </div>{{!-- /.forge-config-base --}}

      <div class="forge-config-custom">

      {{!-- Custom Power Builder --}}
      <h3><i class="fas fa-wand-magic-sparkles"></i> Custom Power</h3>
      <div class="custom-power-builder">
        <div class="custom-row">
          <input type="text" class="custom-power-name" placeholder="Effect Name" />
          <input type="text" class="custom-power-namelabel" placeholder="Relic Name Word" />
        </div>

        {{!-- Quick-fill: pick a stat / skill / save and a +/- value, and the
              raw fields below populate automatically. The raw row is still
              editable so power users can tweak anything afterwards. --}}
        <div class="custom-row custom-row-quickfill">
          <select class="custom-power-quickfill-target" title="Pick a stat, skill, or save to auto-fill the path">
            <option value="">— Quick fill: pick stat / skill / save —</option>
            {{#each quickFillGroups}}
              <optgroup label="{{label}}">
                {{#each targets}}
                  <option value="{{path}}" data-label="{{label}}">{{label}}</option>
                {{/each}}
              </optgroup>
            {{/each}}
          </select>
          <input type="number" class="custom-power-quickfill-value" placeholder="±N" step="1" title="Modifier — fills the Value field below (negative numbers OK)" />
        </div>

        <div class="custom-row">
          <input type="text" class="custom-power-key" placeholder="system.stats.might.bonus" />
          <select class="custom-power-mode">
            <option value="2">Add (+)</option>
            <option value="5">Override (=)</option>
            <option value="1">Multiply (×)</option>
          </select>
          <input type="text" class="custom-power-value" placeholder="Value" />
        </div>
        <div class="custom-row">
          <input type="text" class="custom-power-description" placeholder="Description (shown on the power card)" />
        </div>
        <div class="custom-row custom-row-actions">
          <button type="button" class="add-custom-btn" title="Add to this relic only — not saved for reuse">
            <i class="fas fa-plus"></i> Add Once
          </button>
          <button type="button" class="save-custom-btn" title="Save to the Custom category so you can reuse it on other relics">
            <i class="fas fa-floppy-disk"></i> Save Custom
          </button>
        </div>
      </div>

      </div>{{!-- /.forge-config-custom --}}
      </div>{{!-- /.forge-config-grid --}}

      {{!-- Forge Button --}}
      <button type="button" class="forge-btn {{#unless canForge}}disabled{{/unless}}"
              {{#unless canForge}}disabled{{/unless}}>
        <i class="fas fa-fire"></i> Forge Relic
      </button>
    </div>

    {{!-- RIGHT: Selected Powers --}}
    <div class="forge-column selected-panel">
      <h3><i class="fas fa-list-check"></i> Selected Powers ({{selectedPowers.length}})</h3>

      <div class="selected-powers-list">
        {{#each selectedPowers}}
        <div class="selected-power-card">
          <div class="power-icon"><i class="{{icon}}"></i></div>
          <div class="power-info">
            <div class="power-name">{{name}} <span class="power-cost-tag">{{costDisplay}}</span></div>
            <div class="power-desc">{{description}}</div>
            {{#if requiresInput}}
            <div class="power-input-row">
              <label>{{inputLabel}}:</label>
              {{#if isSelect}}
              <select class="power-user-input" data-power-id="{{id}}">
                <option value="">— Select —</option>
                {{#each inputOptions}}
                <option value="{{this}}">{{this}}</option>
                {{/each}}
              </select>
              {{else}}
              <input type="text" class="power-user-input" data-power-id="{{id}}"
                     value="{{userInput}}" placeholder="{{inputLabel}}" />
              {{/if}}
            </div>
            {{/if}}
          </div>
          <button type="button" class="remove-btn" data-power-id="{{id}}" title="Remove">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        {{/each}}

        {{#each customPowers}}
        <div class="selected-power-card custom">
          <div class="power-icon"><i class="fas fa-wand-magic-sparkles"></i></div>
          <div class="power-info">
            <div class="power-name">{{name}} <span class="custom-tag">Custom</span></div>
            <div class="power-desc">{{description}}</div>
          </div>
          <button type="button" class="remove-btn" data-custom-index="{{index}}" title="Remove">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        {{/each}}

        {{#unless selectedPowers.length}}
          {{#unless customPowers.length}}
          <div class="empty-state">
            <i class="fas fa-wand-sparkles"></i>
            <p>No powers selected</p>
          </div>
          {{/unless}}
        {{/unless}}
      </div>
    </div>

  </div>
</div>
